# Web demo (web/) environment. Copy to .env.local ONLY on your own machine,
# or set these in the Vercel project. Never commit real values.
#
# The public demo needs NONE of these: answers are deterministic (no AI key)
# and read-aloud uses the browser's own voice.
#
# Optional ElevenLabs read-aloud. It is on only when BOTH are set:
VOICE_PROVIDER=
ELEVENLABS_API_KEY=
# Optional voice id (a premade voice is used by default).
ELEVENLABS_VOICE_ID=
